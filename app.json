{
  "expo": {
    "name": "Axei",
    "slug": "axei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Axei.png",
    "scheme": "axei",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.axei",
      "icon": "./assets/images/Axei.png"
    },
    "android": {
      "package": "br.axei",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "O Axei usa o microfone para gravar áudios nos cartões."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Axei acessa suas fotos para adicioná-las aos cartões.",
          "cameraPermission": "O Axei usa a câmera para tirar fotos dos cartões.",
          "microphonePermission": "O Axei usa o microfone para gravar áudios nos cartões."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a03243b-9792-4150-a6f2-a9a558602d2a"
      }
    },
    "owner": "uyran"
  }
}
